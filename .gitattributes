# Normalize all text files to LF in the repo and working tree (Win + Linux).
# This overrides each machine's core.autocrlf, so line endings are identical
# everywhere and Biome (LF default) stays happy.
* text=auto eol=lf

# Explicitly treat common binary assets as binary (no conversion).
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.svg  text eol=lf
*.woff  binary
*.woff2 binary
